# Copy to .env.local and fill in the values.
# Full explanations for every variable are in DEPLOYMENT.md.

# ---- Required ----

# MongoDB Atlas connection string. Use the existing database so current
# bookings, guests and prices carry over.
MONGODB_URI=

# Password for /admin. Use a long random string — anyone with this can approve
# bookings and change prices.
ADMIN_KEY=

# ---- WhatsApp (Meta Cloud API) ----

# Keep this false locally so testing never messages real guests.
WHATSAPP_ENABLED=false

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Any secret string you choose. Must match the "Verify token" you enter in the
# Meta webhook configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Optional — sensible defaults are built in.
# WHATSAPP_USE_TEMPLATES=true
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_TEMPLATE_BOOKING_CREATED=booking_received
# WHATSAPP_TEMPLATE_BOOKING_APPROVED=booking_confirmed

# Only set to true AFTER the booking_received template is re-approved with an
# 8th variable for the tracking link — otherwise every send fails on a
# parameter-count mismatch.
# WHATSAPP_CREATED_TEMPLATE_HAS_LINK=false

# ---- Details sent to guests ----

# Public site URL, used to build tracking links. No trailing slash.
FRONTEND_URL=http://localhost:3000

FARMHOUSE_NAME=Vicky Farmhouse
FARMHOUSE_LOCATION_URL=
FARMHOUSE_CONTACT=
